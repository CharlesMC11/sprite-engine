---
title: Pause Menu
---
stateDiagram-v2
    [*] --> Menu: Game Paused
    Menu --> [*]: Close / Quit

    Menu --> Sketchbook: Select
    Sketchbook --> Menu: Close
    state Sketchbook {
        state "Mission List" as MissionList
        [*] --> MissionList: Open
        state "Mission Details" as Mission
        MissionList --> Mission: Select
        Mission --> MissionList: Close
    }
    Sketchbook --> [*]: Fast Travel

    state "To-Do List" as ToDoList
    Menu --> ToDoList: Select
    ToDoList --> Menu: Close
    state ToDoList {
        state "Quest List" as QuestList
        [*] --> QuestList: Open
        state "Quest Details" as Quest
        QuestList --> Quest: Select
        Quest --> QuestList: Close
    }

    Menu --> Notes: Select
    Notes --> Menu: Close
    state Notes {
        state "Character List" as CharacterList
        [*] --> CharacterList: Open
        state "Character Details" as Character
        CharacterList --> Character: Select
        Character --> CharacterList: Close
    }

    Menu --> Toolbag: Select
    Toolbag --> Menu: Close
    state Toolbag {
        state "Item List" as ItemList
        [*] --> ItemList
        state "Item Details" as Item
        ItemList --> Item: Select
        Item --> ItemList: Close
    }

    Character --> Toolbag: Select Equipment to Equip
    Toolbag --> Character: Done / Cancel

    Item --> Notes: Select Character to Equip
    Notes --> Item: Done / Cancel

    state "Saving Progress" as Journal
    Menu --> Journal: Select Journal
    Journal --> Menu: Done

    Menu --> Settings: Select
    Settings --> Menu: Close
